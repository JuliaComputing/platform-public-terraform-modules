{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketScopedToPlatformPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${datasets_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": ${jsonencode(datasets_list_prefixes)}
        }
      }
    },
    {
      "Sid": "ObjectAccessWithinPlatformPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": ${jsonencode(datasets_object_arns)}
    }
  ]
}
